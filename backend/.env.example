# Virtual Environment
# Always activate virtual environment before running Python commands:
# Windows: venv\Scripts\activate
# Mac/Linux: source venv/bin/activate

# Supabase Configuration
SUPABASE_URL=url
SUPABASE_KEY=key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Settings (if using authentication)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integration Testing (for test_real_db_roundtrip.py)
# Get token from frontend: Login → DevTools → Application → Local Storage → supabase.auth.token
TEST_AUTH_TOKEN=your_jwt_token_here
API_BASE_URL=http://localhost:8000


# Mapbox for geocoding (use SECRET token, not public token)
# Mapbox Studio → Account → Access tokens → Create token → Secret token
# URL restrictions:
#   - https://eventradius-api.onrender.com/* (production)
#   - http://localhost:8000/* (local development)
MAPBOX_API_KEY=sk.your_secret_token_here
